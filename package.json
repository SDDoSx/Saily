{
  "name": "saily",
  "version": "0.9.0",
  "description": "Offline-capable GPS passage app for small craft: route guidance, traffic-separation-scheme and hazard alerts, marine weather go/no-go. Bundled passage: Sotogrande to Tangier across the Strait of Gibraltar.",
  "license": "MIT",
  "private": true,
  "repository": { "type": "git", "url": "https://github.com/SDDoSx/Saily" },
  "scripts": {
    "start": "node tools/serve.js",
    "test": "node tools/unit.js && NODE_PATH=${NODE_PATH:-/opt/node22/lib/node_modules} node tools/e2e.js",
    "test:unit": "node tools/unit.js",
    "test:e2e": "node tools/e2e.js",
    "build:chart": "python3 tools/build_chart.py ${SAILY_SCRATCH:-/tmp/saily-data} site/chart-data.js",
    "build:single": "python3 tools/build_single.py dist/saily.html tools/out/wx_snapshot.json"
  },
  "devDependencies": { "playwright": "^1.56.1" },
  "engines": { "node": ">=18" }
}
